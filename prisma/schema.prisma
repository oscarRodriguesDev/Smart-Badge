generator client {
provider = "prisma-client-js"
output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_SYSTEM
  GENERAL_ADMIN
  OP
  SESMT_ADMIN
  SESMT_USER
  RH_ADMIN
  RH_USER
  CONTROLER
}

model User {
  id          String  @id @default(cuid())
  urlPhoto    String?
  cpf         String  @unique
  email       String  @unique
  senha       String
  telefone    String?
  endereco    String?
  cidade      String?
  estado      String?
  cep         String?
  pais        String?
  complemento String?
  nome        String
  matricula   String  @unique
  cargo       String
  setor       String
  foto        String?
  turno       String?

  role Role

  areasPermitidas String[]
  niveisAcesso    String[]
  bloqueios       String[]

  asoStatus     String
  asoUltimo     DateTime?
  asoVencimento DateTime?
  asoRestricoes String?

  treinamentos  Treinamento[]
  certificacoes Certificacao[]
  epis          Epi[]
  acidentes     Acidente[]
  atestados     Atestado[]
  ferias        Ferias?

  situacaoGeral      String
  motivoDesligamento String?
  itensViculados     Itens[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Treinamento {
  id          String    @id @default(cuid())
  nome        String
  concluidoEm DateTime?
  venceEm     DateTime?
  status      String
  userId      String
  user        User      @relation(fields: [userId], references: [id])
}

model Certificacao {
  id        String    @id @default(cuid())
  nome      String
  emitidaEm DateTime?
  venceEm   DateTime?
  status    String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
}

model Epi {
  id         String    @id @default(cuid())
  item       String
  retiradoEm DateTime?
  devolvido  Boolean   @default(false)
  quantidade Int       @default(1)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
}

model Acidente {
  id          String   @id @default(cuid())
  data        DateTime
  descricao   String?
  afastamento Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Atestado {
  id     String   @id @default(cuid())
  inicio DateTime
  fim    DateTime
  motivo String?
  userId String
  user   User     @relation(fields: [userId], references: [id])
}

model Ferias {
  id                String  @id @default(cuid())
  periodoAquisitivo String
  proximoPeriodo    String?
  status            String
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id])
}

model Itens{
  id          String   @id @default(cuid())
  nome        String
  dataEntrada DateTime?
  tipo        String?
  Equipamento  String?
  Marca       String?
  Modelo      String?
  numeroSerie String?
  descricao   String?
  userId      String
  status      String?
  dataSaida   DateTime?
  user        User    @relation(fields: [userId], references: [id])
}
